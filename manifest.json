{
  "manifest_version": 3,
  "name": "Screen-to-Dispatch",
  "version": "1.0.0",
  "description": "Select website elements and create structured edit requests for Dispatch.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Screen-to-Dispatch"
  },
  "options_page": "options.html"
}
